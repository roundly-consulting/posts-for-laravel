{
    "name": "roundly-consulting/posts-for-laravel",
    "description": "A modern, multilingual, SEO-ready blog/posts engine for Laravel with translatable content, a publishing lifecycle, categories, and tags.",
    "keywords": [
        "roundly-consulting",
        "laravel",
        "posts",
        "blog",
        "cms",
        "translatable",
        "seo"
    ],
    "homepage": "https://roundly-consulting.com/open-source/docs/posts-for-laravel",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrej Mihaliak",
            "email": "andrej@mihaliak.com",
            "role": "Developer"
        }
    ],
    "support": {
        "docs": "https://roundly-consulting.com/open-source/docs/posts-for-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^12.0|^13.0",
        "roundly-consulting/approvals-for-laravel": "^1.0",
        "roundly-consulting/enums-for-laravel": "^1.0",
        "roundly-consulting/likes-for-laravel": "^1.0",
        "roundly-consulting/media-library-for-laravel": "^1.0",
        "roundly-consulting/package-toolkit-for-laravel": "^1.0",
        "roundly-consulting/reports-for-laravel": "^1.0",
        "roundly-consulting/sluggable-for-laravel": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.0",
        "nunomaduro/collision": "^8.0",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "roundly-consulting/testing-for-laravel": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "RoundlyConsulting\\Posts\\": "src",
            "RoundlyConsulting\\Posts\\Database\\Factories\\": "database/factories"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoundlyConsulting\\Posts\\Tests\\": "tests"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse --no-progress",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage --min=90"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "RoundlyConsulting\\Posts\\PostsServiceProvider"
            ],
            "aliases": {
                "Posts": "RoundlyConsulting\\Posts\\Facades\\Posts"
            }
        }
    }
}
